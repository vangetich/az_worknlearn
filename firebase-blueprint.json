{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Learner account profile and role in the AZ-900 Smart Quiz Builder.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID matching the document ID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Unique learner email address.",
          "minLength": 3,
          "maxLength": 254
        },
        "fullName": {
          "type": "string",
          "description": "Learner full name.",
          "minLength": 1,
          "maxLength": 120
        },
        "role": {
          "type": "string",
          "description": "User role tier.",
          "enum": ["student", "bootcamp_admin", "enterprise_user"]
        },
        "isPremium": {
          "type": "boolean",
          "description": "Whether the learner has unlocked premium modules via M-Pesa or Stripe."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": ["uid", "email", "fullName", "role", "isPremium", "createdAt", "updatedAt"]
    },
    "UserProgress": {
      "title": "UserProgress",
      "description": "Per-module mastery score and status for a specific learner.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner Firebase Auth UID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "moduleId": {
          "type": "integer",
          "description": "Curriculum module number (1 to 12)."
        },
        "score": {
          "type": "integer",
          "description": "Percentage mastery score (0 to 100)."
        },
        "status": {
          "type": "string",
          "description": "Mastery status for the module.",
          "enum": ["not_started", "in_progress", "mastered"]
        },
        "lastAttempted": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp of last question attempt."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Record creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Record update timestamp."
        }
      },
      "required": ["userId", "moduleId", "score", "status", "lastAttempted", "createdAt", "updatedAt"]
    },
    "QuizSessionRecord": {
      "title": "QuizSessionRecord",
      "description": "Completed quiz session telemetry record.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner Firebase Auth UID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "questionsAnswered": {
          "type": "integer",
          "description": "Total questions answered in session."
        },
        "correctCount": {
          "type": "integer",
          "description": "Total questions answered correctly."
        },
        "completedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when session completed."
        }
      },
      "required": ["userId", "questionsAnswered", "correctCount", "completedAt"]
    },
    "PaymentTransaction": {
      "title": "PaymentTransaction",
      "description": "M-Pesa STK Push or Stripe payment transaction record.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner Firebase Auth UID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "gateway": {
          "type": "string",
          "description": "Payment gateway identifier.",
          "enum": ["mpesa", "stripe"]
        },
        "amount": {
          "type": "integer",
          "description": "Transaction amount."
        },
        "currency": {
          "type": "string",
          "description": "ISO currency code (KES or USD).",
          "enum": ["KES", "USD"]
        },
        "checkoutRequestId": {
          "type": "string",
          "description": "M-Pesa CheckoutRequestID or Stripe session ID.",
          "minLength": 3,
          "maxLength": 128
        },
        "status": {
          "type": "string",
          "description": "Payment settlement status.",
          "enum": ["pending", "completed", "failed"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": ["userId", "gateway", "amount", "currency", "checkoutRequestId", "status", "createdAt", "updatedAt"]
    },
    "StudyChamberCheckin": {
      "title": "StudyChamberCheckin",
      "description": "Per-learner cumulative study progress and domain notes inside one of the 6 Virtual Study Room chambers.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner Firebase Auth UID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "roomId": {
          "type": "string",
          "description": "Canonical chamber room identifier.",
          "enum": [
            "AZ900-CONCEPTS",
            "AZ900-SERVICES",
            "AZ900-SECURITY",
            "AZ900-GOVERNANCE",
            "AZ900-WAR-ROOM",
            "AZ900-CLINIC"
          ]
        },
        "questionsSolved": {
          "type": "integer",
          "description": "Total questions solved in this chamber."
        },
        "correctCount": {
          "type": "integer",
          "description": "Total correct answers in this chamber."
        },
        "handoffsResolved": {
          "type": "integer",
          "description": "Total cross-chamber handoffs or traps resolved."
        },
        "lastNotes": {
          "type": "string",
          "description": "Latest chamber scratchpad note saved by the learner.",
          "minLength": 0,
          "maxLength": 1200
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": ["userId", "roomId", "questionsSolved", "correctCount", "handoffsResolved", "lastNotes", "createdAt", "updatedAt"]
    },
    "StudyChamberHandoff": {
      "title": "StudyChamberHandoff",
      "description": "Inter-chamber question or concept handoff queued by a learner across the 6 study chambers.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner Firebase Auth UID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "fromRoomId": {
          "type": "string",
          "description": "Source study chamber ID.",
          "enum": [
            "AZ900-CONCEPTS",
            "AZ900-SERVICES",
            "AZ900-SECURITY",
            "AZ900-GOVERNANCE",
            "AZ900-WAR-ROOM",
            "AZ900-CLINIC"
          ]
        },
        "toRoomId": {
          "type": "string",
          "description": "Target study chamber ID.",
          "enum": [
            "AZ900-CONCEPTS",
            "AZ900-SERVICES",
            "AZ900-SECURITY",
            "AZ900-GOVERNANCE",
            "AZ900-WAR-ROOM",
            "AZ900-CLINIC"
          ]
        },
        "questionId": {
          "type": "string",
          "description": "Linked AZ-900 question ID.",
          "minLength": 1,
          "maxLength": 128
        },
        "title": {
          "type": "string",
          "description": "Short handoff summary title.",
          "minLength": 1,
          "maxLength": 140
        },
        "note": {
          "type": "string",
          "description": "Learner study note carried between chambers.",
          "minLength": 0,
          "maxLength": 600
        },
        "resolved": {
          "type": "boolean",
          "description": "Whether the escalated trap/handoff has been mastered."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": ["userId", "fromRoomId", "toRoomId", "questionId", "title", "note", "resolved", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Learner account profiles keyed by Firebase Auth UID."
    },
    "/user_progress/{progressId}": {
      "schema": { "$ref": "#/entities/UserProgress" },
      "description": "Per-module progress records for learners."
    },
    "/quiz_sessions/{sessionId}": {
      "schema": { "$ref": "#/entities/QuizSessionRecord" },
      "description": "Completed quiz session telemetry logs."
    },
    "/payment_transactions/{txId}": {
      "schema": { "$ref": "#/entities/PaymentTransaction" },
      "description": "M-Pesa Daraja STK Push and Stripe payment transactions."
    },
    "/study_chamber_checkins/{checkinId}": {
      "schema": { "$ref": "#/entities/StudyChamberCheckin" },
      "description": "Per-learner cumulative progress and saved notes across the 6 study chambers."
    },
    "/study_chamber_handoffs/{handoffId}": {
      "schema": { "$ref": "#/entities/StudyChamberHandoff" },
      "description": "Cross-chamber study handoffs and escalated traps synced for learners."
    }
  }
}
